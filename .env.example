# 배포와 fork 테스트에 쓰는 값. 실제 값은 .env 에 두고 커밋하지 않는다.

GIWA_SEPOLIA_RPC_URL=https://sepolia-rpc.giwa.io
GIWA_SEPOLIA_EXPLORER_URL=https://sepolia-explorer.giwa.io

# DojangScroll 프리디플로이. 비우면 배포 스크립트의 기본값을 쓴다.
DOJANG_SCROLL_ADDRESS=0xd5077b67dcb56caC8b270C7788FC3E6ee03F17B9

# 인증 판정 기준이 되는 attester. 바꾸면 누가 verified 로 기록되는지가 달라진다.
# 아래는 현재 배포본과 fork 테스트가 쓰는 TESTNET_FAUCET 이다.
DOJANG_ATTESTER_ID=0xaa92f8c143657dde575de430aecaea6ca91f2e6072339b16932d426895d8d678

# 배포 지갑. 스크립트가 DEPLOYER_PRIVATE_KEY 를 envUint 로 읽으므로 0x 접두사가
# 반드시 있어야 한다. 없으면 10진수로 읽혀 엉뚱한 주소로 배포된다.
DEPLOYER_ADDRESS=
DEPLOYER_PRIVATE_KEY=
